STARTING_CASH=50000
MAX_RISK_PER_TRADE=250
DAILY_LOSS_LIMIT=1000
MAX_OPEN_POSITIONS=3
DATABASE_PATH=./paper_trader.db

# FinStack MCP free mode; no broker credentials required
MCP_COMMAND=python
MCP_ARGS_JSON=["-m","app.finstack_launcher"]
MCP_UNIVERSE_TOOL=sensex_components
MCP_UNIVERSE_ARGS_JSON={"index_name":"nifty50"}
MCP_QUOTE_TOOL=nse_quote
MCP_QUOTE_ARGS_JSON={"symbol":"{symbol}"}
MCP_CANDLES_TOOL=nse_historical
# FinStack accepts 5m/15m intervals and period=5d for intraday history.
MCP_CANDLES_ARGS_JSON={"symbol":"{symbol}","period":"5d","interval":"{interval}"}
